check_env_value() {
  local key="$1"
  local line=$(grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | head -n1 || true)
  [ -z "$line" ] && { echo ""; return; }
  local val="${line#*=}"
  echo "$val" | sed -E "s/^[[:space:]'\"]+//; s/[[:space:]'\"]+$//"
}

