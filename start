run_with_restart() {
  local name="$1"
  local script="$2"
  local logfile="$3"
  local max_restart=5
  local count=0

  while [ $count -lt $max_restart ]; do
    echo -e "\n[$(date '+%Y-%m-%d %H:%M:%S')] Starting $name (#$((count+1)))" >> "$logfile"
    "$PYTHON_BIN" -u "$script" >> "$logfile" 2>&1
    local ec=$?
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $name exit code=$ec" >> "$logfile"
    count=$((count+1))
    if [ $ec -ne 0 ] && [ $count -lt $max_restart ]; then
      warn "$name crash — restart 5s... ($count/$max_restart)"
      sleep 5
    else
      break
    fi
  done
}

