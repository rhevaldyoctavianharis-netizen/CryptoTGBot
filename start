  "$PYTHON_BIN" -m pip install --upgrade pip -q "${PIP_FLAGS[@]}" || true
  if ! "$PYTHON_BIN" -m pip install -r "$REQ_FILE" -q "${PIP_FLAGS[@]}"; then
    err "Gagal install. Coba: $PYTHON_BIN -m pip install ${PIP_FLAGS[*]} -r $REQ_FILE"
